.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/.last_warm
.gitreins/tasks.yaml
.coverage

# Temp audit / inspection scripts (generated by foreman ticks)
# Anchored to repo root: an unanchored `_*.py` also matched package
# __init__.py files, which hatchling's gitignore-based wheel file selection
# then excluded from built wheels (empty namespace package on install).
/_*.py
# GitReins verdict history (local)
.gitreins/history/
.gitreins/usage.jsonl

# pytest-benchmark cache (regenerated on every run)
.benchmarks/

# DuckDB board local cache (rebuildable from JSONL canonical store)
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet

.coding-hermes/board/*.duckdb

# Local board header (untracked by design — JSONL-canonical board)
.coding-hermes/board/board.jsonl

# Local engine caches (rebuildable)
/board.db
/dagger.db*

# Local DuckBrain namespace cache (test artifact, not SDK content)
/namespaces/

# Stale E2E ghost checkpoints (GAP-020, 2026-08-10) — battery results
# live in CI logs / docs/dogfood/, never in repo output dirs
e2e-output/
