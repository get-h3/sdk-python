.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/.last_warm
.gitreins/tasks.yaml
.coverage

# Temp audit / inspection scripts (generated by foreman ticks)
# Anchored to repo root: an unanchored `_*.py` also matched package
# __init__.py files, which hatchling's gitignore-based wheel file selection
# then excluded from built wheels (empty namespace package on install).
/_*.py
# GitReins verdict history (local)
.gitreins/history/

# pytest-benchmark cache (regenerated on every run)
.benchmarks/

# DuckDB board local cache (rebuildable from Parquet)
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet

.coding-hermes/board/*.duckdb
